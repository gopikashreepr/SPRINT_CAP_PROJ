                      "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                      "const res = pm.response.json();",
                      "pm.test('Token is present', () => pm.expect(res.token).to.be.a('string').and.not.empty);",
                      "if (res.token) { pm.environment.set('token', res.token); }",
                      "pm.test('Status is Success', () => pm.expect(res.status).to.eql('Success'));"
                    ]
