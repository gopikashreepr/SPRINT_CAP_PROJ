{
  "info": {
    "name": "BookStore Live",
    "description": "Full ToolsQA BookStore API - Account + BookStore modules, hitting the real API. Uses request chaining: GenerateToken -> token, Create User -> userId, consumed by downstream BookStore requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Account",
      "item": [
        {
          "name": "Create User",
          "item": [
            {
              "name": "Create User - Positive",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "// Pre-request script #1: generate a unique username so re-runs don't fail on duplicate-user errors",
                      "const uniqueName = 'user_' + Date.now();",
                      "pm.environment.set('username', uniqueName);",
                      "pm.environment.set('password', 'Password@123!');"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                      "const res = pm.response.json();",
                      "pm.test('userId returned', () => pm.expect(res.userId).to.exist);",
                      "if (res.userId) { pm.environment.set('userId', res.userId); }"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "{{contentType}}" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/Account/v1/User",
                  "host": ["{{baseUrl}}"],
                  "path": ["Account", "v1", "User"]
                }
              },
              "response": [
                {
                  "name": "201 Created",
                  "originalRequest": {
                    "method": "POST",
                    "header": [{ "key": "Content-Type", "value": "{{contentType}}" }],
                    "body": { "mode": "raw", "raw": "{\n  \"userName\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
                    "url": { "raw": "{{baseUrl}}/Account/v1/User", "host": ["{{baseUrl}}"], "path": ["Account", "v1", "User"] }
                  },
                  "status": "Created",
                  "code": 201,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"userID\": \"a1b2c3d4-0000-1111-2222-333344445555\",\n  \"username\": \"user_1735000000000\",\n  \"books\": []\n}"
                }
              ]
            },
            {
              "name": "Create User - Negative (weak password)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
