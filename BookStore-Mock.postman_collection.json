  "item": [
    {
      "name": "Get All Books",
      "item": [
        {
          "name": "Get All Books - Positive",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has books array', () => {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.books).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/BookStore/v1/Books",
              "host": ["{{baseUrl}}"],
              "path": ["BookStore", "v1", "Books"]
            }
          },
          "response": [
            {
              "name": "200 OK - Books List",
              "originalRequest": {
                "method": "GET",
                "header": [{ "key": "Content-Type", "value": "{{contentType}}" }],
                "url": {
                  "raw": "{{baseUrl}}/BookStore/v1/Books",
                  "host": ["{{baseUrl}}"],
                  "path": ["BookStore", "v1", "Books"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"books\": [\n    {\n      \"isbn\": \"9781449325862\",\n      \"title\": \"Git Pocket Guide\",\n      \"subTitle\": \"A Working Introduction\",\n      \"author\": \"Richard E. Silverman\",\n      \"publish_date\": \"2020-06-04T08:48:39.000Z\",\n      \"publisher\": \"O'Reilly Media\",\n      \"pages\": 234,\n      \"description\": \"An introductory guide to Git\",\n      \"website\": \"https://www.git-scm.com\"\n    },\n    {\n      \"isbn\": \"9781449331818\",\n      \"title\": \"Learning JavaScript Design Patterns\",\n      \"subTitle\": \"A JavaScript and jQuery Developer's Guide\",\n      \"author\": \"Addy Osmani\",\n      \"publish_date\": \"2020-06-04T08:48:39.000Z\",\n      \"publisher\": \"O'Reilly Media\",\n      \"pages\": 254,\n      \"description\": \"Design patterns in JavaScript\",\n      \"website\": \"https://www.oreilly.com\"\n    }\n  ]\n}"
            }
          ]
        }
      ]
